DATABASE_URL=sqlite:///data/research.db
# Approved local or synchronized master workbook; saved values are read without modification.
EXCEL_WORKBOOK_PATH=
EXCEL_SETTLE_SECONDS=5
EXCEL_POLL_SECONDS=10
# Keep audit artifacts in a local, non-synchronized folder (default: local AppData).
